<Window x:Class="ATMML.OrderBlotter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order Blotter — FlexOne"
        Height="650" Width="1320"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin"  Value="4,0"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#7A1F1F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7A1F1F"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#0E5A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0E5A8A"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCDCDC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock Text="Mode:" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtMode" Text="MOCK" FontWeight="Bold"
                       Foreground="#FFB800" VerticalAlignment="Center" Margin="0,0,16,0"/>

            <TextBlock Text="Active orders:" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtActiveCount" Text="0" FontWeight="Bold"
                       Margin="4,0,16,0" VerticalAlignment="Center"/>

            <TextBlock Text="Strategy filter:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="CmbStrategy" Width="160" VerticalAlignment="Center"
                      Background="#2D2D30" Foreground="#DCDCDC" BorderBrush="#3F3F46"
                      SelectionChanged="CmbStrategy_SelectionChanged"/>

            <CheckBox x:Name="ChkShowAll" Content="Show inactive" Foreground="#DCDCDC"
                      VerticalAlignment="Center" Margin="16,0" Click="ChkShowAll_Click"/>

            <Button DockPanel.Dock="Right" Content="Cancel ALL" Style="{StaticResource DangerBtn}"
                    Click="BtnCancelAll_Click"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource ToolBtn}"
                    Click="BtnRefresh_Click"/>
        </DockPanel>

        <!-- Grid -->
        <DataGrid x:Name="OrderGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="#252526"
                  Foreground="#DCDCDC"
                  RowBackground="#252526"
                  AlternatingRowBackground="#2A2A2B"
                  BorderBrush="#3F3F46"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OrderGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ClOrdID"   Binding="{Binding ClOrdId}"   Width="210"/>
                <DataGridTextColumn Header="Symbol"    Binding="{Binding Symbol}"    Width="80"/>
                <DataGridTextColumn Header="Side"      Binding="{Binding Side}"      Width="80"/>
                <DataGridTextColumn Header="Type"      Binding="{Binding Type}"      Width="80"/>
                <DataGridTextColumn Header="Qty"       Binding="{Binding Qty}"       Width="70"/>
                <DataGridTextColumn Header="Filled"    Binding="{Binding FilledQty}" Width="70"/>
                <DataGridTextColumn Header="Leaves"    Binding="{Binding LeavesQty}" Width="70"/>
                <DataGridTextColumn Header="Limit"     Binding="{Binding LimitPrice, StringFormat=N4}" Width="80"/>
                <DataGridTextColumn Header="AvgPx"     Binding="{Binding AvgPx, StringFormat=N4}"      Width="80"/>
                <DataGridTextColumn Header="Status"    Binding="{Binding Status}"    Width="110"/>
                <DataGridTextColumn Header="Strategy"  Binding="{Binding Strategy}"  Width="120"/>
                <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedAt, StringFormat=HH:mm:ss}" Width="80"/>
                <DataGridTextColumn Header="Last Msg"  Binding="{Binding LastMessage}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Modify…"        Click="MenuModify_Click"/>
                    <MenuItem Header="Cancel"         Click="MenuCancel_Click"/>
                    <Separator/>
                    <MenuItem Header="Copy ClOrdID"   Click="MenuCopyId_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Action bar -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left"
                       Foreground="#9A9A9A" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close"   Style="{StaticResource ToolBtn}"   Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancel"  Style="{StaticResource DangerBtn}" Click="BtnCancelSelected_Click"/>
            <Button DockPanel.Dock="Right" Content="Modify…" Style="{StaticResource PrimaryBtn}" Click="BtnModifySelected_Click"/>
        </DockPanel>
    </Grid>
</Window>
