<UserControl x:Class="ATMML.AOD3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ATMML" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Visibility="Visible" mc:Ignorable="d">

    <Grid Name="AODPanel" Grid.Row="0" Grid.Column="0" Margin="8,0,0,8" Height="252" 
          Background="black" Visibility="Visible">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Rectangle x:Name="BlueRec" Grid.Row="0" Grid.RowSpan="16" Grid.Column="0" 
                   Grid.ColumnSpan="6" Margin="0,0,0,2" Fill="Black" Stroke="#FF124b72"
                   StrokeThickness="1" Visibility="Visible" />
        <Rectangle x:Name="RecHighLight" Grid.Row="0" Grid.RowSpan="16" Grid.Column="0"
                   Grid.ColumnSpan="6" Margin="0,0,0,2" Fill="Black" Stroke="#00ccff"
                   StrokeThickness="1" Visibility="Collapsed" />
        <Rectangle x:Name="WhiteRec" Grid.Row="0" Grid.RowSpan="16" Grid.Column="0"
                   Grid.ColumnSpan="6" Margin="0,0,0,2" Fill="Black" Stroke="WhiteSmoke"
                   StrokeThickness="1" Visibility="Collapsed" />

        <Label Name="AddNewAOD" Grid.Row="0" Grid.Column="0" Margin="6,0,0,0" FontWeight="Bold" Padding="0"
               HorizontalAlignment="Left"  Content="+" FontFamily="Helvetica Neue" Cursor="Hand" 
               FontSize="18" Foreground="WhiteSmoke" MouseDown="AddNewAOD_MouseDown" MouseEnter="OurView_MouseEnter"
               MouseLeave="OurView_MouseLeave" ToolTip="Add Another Monitor" ToolTipService.BetweenShowDelay="1000"
               ToolTipService.InitialShowDelay="500" ToolTipService.IsEnabled="True" ToolTipService.ShowDuration="15000"/>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <TextBox Name="TickerSymbol" Margin="0,0,0,0" HorizontalAlignment="right" VerticalAlignment="Center"  FontWeight="Medium"
                     FontFamily="Helvetica Neue" FontSize="10" Foreground="White" Text="" />
        </StackPanel>

        <Label Name="CloseAOD" Grid.Row="0" Grid.Column="5" Margin="0,0,0,0"
               HorizontalAlignment="Right" VerticalAlignment="Center" Content="&#x274C;" FontFamily="Helvetica Neue" Cursor="Hand" 
               FontSize="10" Foreground="WhiteSmoke" MouseDown="CloseAOD_MouseDown" MouseEnter="OurView_MouseEnter"
               MouseLeave="OurView_MouseLeave" ToolTip="Delete This Monitor" ToolTipService.BetweenShowDelay="1000"
               ToolTipService.InitialShowDelay="500" ToolTipService.IsEnabled="True" ToolTipService.ShowDuration="15000" />

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Label Name="Desc" Margin="0,0,0,0" Content="" FontFamily="Helvetica Neue"  FontWeight="Medium"
                   FontSize="10" Foreground="#00ccff" />
        </StackPanel>

        <Label Name="SourceButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
               Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="MARKETS" Cursor="Hand"
               FontFamily="Helvetica Neue" FontSize="10" Foreground="white" MouseDown="SourceButton_MouseDown"  FontWeight="Medium"
               MouseEnter="OurView_MouseEnter" MouseLeave="OurView_MouseLeave" ToolTip="Click to Select your Pricing Source" ToolTipService.BetweenShowDelay="1000"
               ToolTipService.InitialShowDelay="500" ToolTipService.IsEnabled="True" ToolTipService.ShowDuration="15000" />

        <Label x:Name="Cl" Grid.Row="2"  Grid.Column="0" 
               Grid.ColumnSpan="6" Margin="0,0,0,0"  HorizontalAlignment="Center"  HorizontalContentAlignment="Center" VerticalAlignment="Center"
               Content="" FontFamily="Helvetica Neue" FontSize="10"
               Foreground="Silver" />

        <!--  Position Collapsed -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Margin="4,2,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Visibility="Collapsed"
                    Orientation="Horizontal">
            <TextBlock x:Name="StrategyPosition"  VerticalAlignment="Center"
                   Margin="4,0,0,0" HorizontalAlignment="Left"  Text="long"
                   FontFamily="Helvetica Neue" FontSize="10" Foreground="Transparent" />
            <TextBlock x:Name="CurrentTrendInterval"  HorizontalAlignment="left" Margin="0,0,0,0"
                   Text="" FontFamily="Helvetica Neue" FontSize="10" Foreground="White" />
        </StackPanel>

        <!--  Interval-->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" HorizontalAlignment="Right" Margin="0,0,2,0" VerticalAlignment="Center"
                    Orientation="Horizontal">
            <TextBlock Name="IntervalText" Margin="0,5,0,0" Background="Black" FontFamily="Helvetica Neue"   FontWeight="Medium"
                       FontSize="10" Foreground="White" />
            <ComboBox Name="IntervalSelector" Cursor="Hand"   Width="22" Height="22">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="false" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Black" BorderBrush="Black" BorderThickness="1">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Fill="White" Data="M0,0 L3,3 L6,0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="2,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="Black" BorderBrush="Black" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
            </ComboBox>
        </StackPanel>

        <Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Height="1" VerticalAlignment="Top"
                   Margin="8,0,8,0" Fill="#FF124b72" />

        <!-- MT  Rec  -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6"  Margin="6,2,0,0" HorizontalAlignment="left" Orientation="Horizontal">
            <TextBlock x:Name="CurrentAnalysisIntervalMT"  HorizontalAlignment="left" Margin="2,0,2,0"  FontWeight="Medium"
                       Text="" FontFamily="Helvetica Neue" FontSize="10" Foreground="#00ccff" />
            <TextBlock  x:Name="NewRec" Text="" Margin="2,0,0,0"
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
            <TextBlock x:Name="MTtrendMessage"  Margin="5,0,0,0" HorizontalAlignment="left"  Text=""
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
            <TextBlock  Margin="0,0,0,0" HorizontalAlignment="left" Text=" | "  
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
            <TextBlock x:Name="MTpositionMessage"  Margin="0,0,0,0" HorizontalAlignment="left" Text="" 
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
        </StackPanel>

        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6"  Margin="6,0,2,0"  Grid.RowSpan="4"  VerticalAlignment="Top" >
            <WrapPanel Grid.IsSharedSizeScope="True" Orientation="Horizontal"   Width="Auto"  >
                <TextBlock TextWrapping="WrapWithOverflow"    
                        HorizontalAlignment="left" Text=""  VerticalAlignment="Top" Padding="1"
                       FontFamily="Arial" FontSize="10" Foreground="Transparent"> 
                    <Run x:Name="MTMoMessage"></Run>
                    <Run x:Name="PriceMTMessage"></Run>
                </TextBlock>
             </WrapPanel>
        </Grid>

        <!-- ST Current  -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="6"  Margin="6,2,0,0" HorizontalAlignment="left" Orientation="Horizontal">
            <TextBlock x:Name="CurrentAnalysisInterval0"  HorizontalAlignment="left" Margin="2,0,2,0" FontWeight="Medium"
                       Text="" FontFamily="Helvetica Neue" FontSize="10" Foreground="#00ccff" />
            <TextBlock x:Name="CurrentDate" Text=""  Margin="2,0,0,0"
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
            <TextBlock x:Name="STTrendText"  Margin="5,0,0,0" HorizontalAlignment="left"  
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
            <TextBlock Margin="0,0,0,0" HorizontalAlignment="left" Text=" | "  
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
            <TextBlock x:Name="CurrentRec"  Margin="0,0,0,0" HorizontalAlignment="left" Text=""  
                       FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
        </StackPanel>

        <TextBlock  Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="6"  Margin="6,0,0,0"   TextWrapping="WrapWithOverflow"   Padding="1"
                        HorizontalAlignment="left" Text="" Grid.RowSpan="4"  VerticalAlignment="Top"
                       FontFamily="Arial" FontSize="10" Foreground="Transparent" >
                <Run x:Name="STMoMessage"></Run>
                <Run x:Name="ModelPosition"></Run>
        </TextBlock>

        <!-- ST  Next -->
        <StackPanel  Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="6" Margin="6,4,2,0"  Orientation="Horizontal">
            <TextBlock x:Name="CurrentAnalysisInterval1"  HorizontalAlignment="left" Text=""  Margin="2,0,2,0" FontWeight="Medium"
                    FontFamily="Helvetica Neue" FontSize="10" Foreground="#00ccff" />
            <TextBlock x:Name="NextDate"  HorizontalAlignment="left" Text=""   Margin="2,0,2,0" 
                    FontFamily="Helvetica Neue" FontSize="10" Foreground="Silver" />
        </StackPanel>

        <TextBlock x:Name="ForecastPosition" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="6" Padding="1"
                    Margin="7,0,0,0" HorizontalAlignment="left" Text="" TextWrapping="WrapWithOverflow"  Grid.RowSpan="4"
                    FontFamily="Arial" FontSize="10" Foreground="Transparent" />


        <Rectangle x:Name="MouseRec" Grid.Row="3" Grid.RowSpan="12" Grid.Column="0"
                   Grid.ColumnSpan="6" Margin="1,1,1,1" Fill="Transparent" Cursor="Hand"  MouseDown="MouseRec_MouseDown" 
                   Stroke="#01000000" StrokeThickness="1" Visibility="Visible"/>


        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,0,2,0" HorizontalAlignment="Right" >
            <TextBlock x:Name="MTTrendChgWarning" Margin="0,0,2,0" HorizontalAlignment="Right" Visibility="Collapsed" FontFamily="Material Design Icons" FontSize="9"
